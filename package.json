{
  "name": "car-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "src/apps/*"
  ],
  "scripts": {
    "build": "pnpm --filter client build && pnpm --filter server build",
    "buildClient": "pnpm --filter client build",
    "buildServer": "pnpm --filter server build",
    "lint": "eslint .",
    "preview": "pnpm --filter client preview",
    "dev": "concurrently \"pnpm --filter server dev\" \"pnpm --filter client dev\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "catalog:",
    "concurrently": "^10.0.3",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "globals": "^17.6.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.59.2"
  },
  "dependencies": {
    "graphql": "^16.14.2"
  }
}
