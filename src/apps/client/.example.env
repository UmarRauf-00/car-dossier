# Client environment variables
# Copy to .env.local in this folder (src/apps/client) and fill in real values:
#   cp .example.env .env.local
# Only VITE_-prefixed vars are exposed, and they end up in the browser bundle,
# so never put secrets here.

# Clerk publishable key (Clerk Dashboard > API Keys)
VITE_CLERK_PUBLISHABLE_KEY=

# Port the server runs on locally. Must match SERVER_PORT in the server's env.
VITE_SERVER_PORT=3001

# Full GraphQL URL. Only needed when deployed; leave unset locally to use
# http://localhost:${VITE_SERVER_PORT}/graphql
# VITE_GRAPHQL_URL=https://your-api.onrender.com/graphql
