# Server environment variables
# Copy to .env.local in this folder (src/apps/server) and fill in real values:
#   cp .example.env .env.local
# .env.local overrides .env and is gitignored. Never commit real secrets.

# Port the API listens on locally. Render injects PORT instead, which takes priority.
SERVER_PORT=3001
# PORT=

# Postgres connection string
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>

# Origin allowed by CORS. Defaults to Vite's dev server if unset.
CLIENT_ORIGIN=http://localhost:5173

# Anthropic API key, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Clerk webhook signing secret (Clerk Dashboard > Webhooks > your endpoint)
CLERK_WEBHOOK_SIGNING_SECRET=
