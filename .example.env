# Root environment variables, used only by docker-compose
# Copy to .env in the repo root and fill in real values:
#   cp .example.env .env
# For running the apps without Docker, see src/apps/server/.example.env
# and src/apps/client/.example.env.

# Postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=postgres

# Server
SERVER_PORT=3001

# Client (build args for Dockerfile.frontend)
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SERVER_PORT=3001
# VITE_GRAPHQL_URL=
